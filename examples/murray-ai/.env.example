# Murray AI investor outreach — environment variables
#
# Copy into your n8n service's docker-compose.yml under `environment:`.
# Real values for Monday ids are auto-generated by running the
# "Murray AI — P1.0 Setup Helper" workflow once both *_BOARD_ID
# vars below are set.

# ---------------------------------------------------------------------------
# PHASE 1 — Monday.com CRM ids
# ---------------------------------------------------------------------------

# Bootstrap values you provide yourself (found in each Monday board URL):
MONDAY_CONTACTS_BOARD_ID=
MONDAY_LEADS_BOARD_ID=

# Group ids (Setup Helper fills these in)
MONDAY_GROUP_NEW_ACTIVE_CONTACTS=
MONDAY_GROUP_NEW_PIPELINE=
MONDAY_GROUP_QUALIFIED=
MONDAY_GROUP_NO_RESPONSE=

# Contacts Board column ids
MONDAY_COL_CONTACT_NAME=
MONDAY_COL_CONTACT_EMAIL=
MONDAY_COL_CONTACT_EMAIL_CONFIDENCE=
MONDAY_COL_CONTACT_COMPANY=
MONDAY_COL_CONTACT_SOURCE=
MONDAY_COL_CONTACT_DATE_ADDED=
MONDAY_COL_CONTACT_STATUS=

# Leads Board column ids
MONDAY_COL_LEAD_NAME=
MONDAY_COL_LEAD_EMAIL=
MONDAY_COL_LEAD_COMPANY=
MONDAY_COL_LEAD_STATUS=
MONDAY_COL_LEAD_SEND_DATE=
MONDAY_COL_LEAD_SUBJECT_LINE=
MONDAY_COL_LEAD_EMAIL_BODY_SNIPPET=
MONDAY_COL_LEAD_REPLY_RECEIVED_DATE=
MONDAY_COL_LEAD_REPLY_SNIPPET=
MONDAY_COL_LEAD_FOLLOW_UP_1_SENT=
MONDAY_COL_LEAD_FOLLOW_UP_2_SENT=
MONDAY_COL_LEAD_FOLLOW_UP_1_DATE=
MONDAY_COL_LEAD_THREAD_ID=

# ---------------------------------------------------------------------------
# PHASE 2 — Lead sourcing + enrichment
# ---------------------------------------------------------------------------

# Apify
APIFY_TOKEN=
APIFY_CRUNCHBASE_ACTOR_ID=
APIFY_WELLFOUND_ACTOR_ID=

# Hunter.io  (accepts either 0-1 fraction (0.9) or 0-100 score (90); workflow normalizes)
HUNTER_API_KEY=
HUNTER_MIN_CONFIDENCE=0.9

# Slack — TWO separate channels, do not mix
# - SLACK_ALERT_CHANNEL_ID    : system alerts only (queue overflow, errors)
# - SLACK_APPROVAL_CHANNEL_ID : Phase 3 email draft approvals only
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL_ID=C0AR99Q4ZUP
SLACK_APPROVAL_CHANNEL_ID=C0ASZ6R2K6E

# Phase 2 tunables
PHASE_2_QUEUE_PAUSE_THRESHOLD=30
PHASE_2_LEAD_FETCH_LIMIT=3

# Phase 1 sub-workflow ids (set after importing Phase 1 workflows)
# Find them in n8n: open each workflow -> the URL has /workflow/<ID>
PHASE_1_CHECK_DUPLICATE_WORKFLOW_ID=
PHASE_1_ADD_TO_CONTACTS_WORKFLOW_ID=

# ---------------------------------------------------------------------------
# PHASE 3-4 — reserved
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# GMAIL_SENDER=kevon@trymurmurai.app
# DECK_PDF_PATH=/files/Murray_AI_Pre-Seed_Deck.pdf
# SLACK_APPROVER_USER_ID=U0ARUAQ3NPN
# DAILY_SEND_LIMIT=15
