# Murray AI investor outreach — environment variables
#
# Copy into your n8n service's docker-compose.yml under `environment:`.
# Values for the Monday.com ids can be generated for you by running the
# "Murray AI — P1.0 Setup Helper" workflow inside n8n (see
# phase-1-monday-crm/00-setup-helper.json) once the two *_BOARD_ID vars
# below are set.

# ---------------------------------------------------------------------------
# PHASE 1 — Monday.com CRM ids
# ---------------------------------------------------------------------------

# Bootstrap values you provide yourself (found in each Monday board URL):
MONDAY_CONTACTS_BOARD_ID=
MONDAY_LEADS_BOARD_ID=

# Contacts Board — group and column ids (Setup Helper fills these in)
MONDAY_CONTACTS_GROUP_NEW_ACTIVE=

MONDAY_CONTACTS_COL_LEAD_NAME=
MONDAY_CONTACTS_COL_EMAIL=
MONDAY_CONTACTS_COL_CONFIDENCE=
MONDAY_CONTACTS_COL_COMPANY=
MONDAY_CONTACTS_COL_SOURCE=
MONDAY_CONTACTS_COL_DATE_ADDED=
MONDAY_CONTACTS_COL_STATUS=

# Leads Board — group and column ids (Setup Helper fills these in)
MONDAY_LEADS_GROUP_NEW_PIPELINE=
MONDAY_LEADS_GROUP_QUALIFIED_REPLY=
MONDAY_LEADS_GROUP_NO_RESPONSE=

MONDAY_LEADS_COL_LEAD_NAME=
MONDAY_LEADS_COL_EMAIL=
MONDAY_LEADS_COL_COMPANY=
MONDAY_LEADS_COL_STATUS=
MONDAY_LEADS_COL_SEND_DATE=
MONDAY_LEADS_COL_SUBJECT_LINE=
MONDAY_LEADS_COL_BODY_SNIPPET=
MONDAY_LEADS_COL_REPLY_DATE=
MONDAY_LEADS_COL_REPLY_SNIPPET=
MONDAY_LEADS_COL_FOLLOW_UP_1_SENT=
MONDAY_LEADS_COL_FOLLOW_UP_2_SENT=
MONDAY_LEADS_COL_FOLLOW_UP_1_DATE=
MONDAY_LEADS_COL_THREAD_ID=

# ---------------------------------------------------------------------------
# PHASE 2+ — reserved (filled in as later phases ship)
# ---------------------------------------------------------------------------
