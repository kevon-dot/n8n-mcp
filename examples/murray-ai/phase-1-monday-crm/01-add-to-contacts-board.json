{
  "name": "Murray AI — P1.1 Add to Contacts Board",
  "nodes": [
    {
      "id": "sticky-001",
      "name": "Placeholders to Swap",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-560, -340],
      "parameters": {
        "content": "## Phase 1.1 — Add to Contacts Board\n\n**Callable sub-workflow.** Inputs: `lead_name`, `email`, `email_confidence` (High|Medium), `company`, `source` (Crunchbase|AngelList).\n\n### Env vars (set in docker-compose)\n- `MONDAY_CONTACTS_BOARD_ID`\n\n### Group ID placeholder\n- `new_active_contacts` → replace with real group id from Monday\n\n### Column ID placeholders (replace with real ids)\n- `lead_name` (text)\n- `email` (email)\n- `email_confidence` (dropdown)\n- `company` (text)\n- `source` (dropdown)\n- `date_added` (date)\n- `status` (dropdown)\n\n### Credentials\n- Attach a `Monday.com API` credential to the HTTP Request node.\n\n### Output\n`{ item_id, success }`",
        "height": 500,
        "width": 420
      }
    },
    {
      "id": "trigger-001",
      "name": "When Called by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-560, 0],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "lead_name", "type": "string" },
            { "name": "email", "type": "string" },
            { "name": "email_confidence", "type": "string" },
            { "name": "company", "type": "string" },
            { "name": "source", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "build-001",
      "name": "Build GraphQL Body",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-300, 0],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({\n  query: 'mutation ($boardId: ID!, $groupId: String!, $itemName: String!, $columnValues: JSON!) { create_item(board_id: $boardId, group_id: $groupId, item_name: $itemName, column_values: $columnValues, create_labels_if_missing: true) { id name } }',\n  variables: {\n    boardId: $env.MONDAY_CONTACTS_BOARD_ID,\n    groupId: 'new_active_contacts',\n    itemName: $json.lead_name,\n    columnValues: JSON.stringify({\n      lead_name: $json.lead_name,\n      email: { email: $json.email, text: $json.email },\n      email_confidence: { label: $json.email_confidence },\n      company: $json.company,\n      source: { label: $json.source },\n      date_added: { date: $now.toFormat('yyyy-MM-dd') },\n      status: { label: 'Queued for Outreach' }\n    })\n  }\n}) }}",
        "options": {}
      }
    },
    {
      "id": "http-001",
      "name": "Monday - Create Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-40, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "mondayComApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "API-Version", "value": "2024-10" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "guard-001",
      "name": "Did It Succeed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.data && $json.data.create_item && $json.data.create_item.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "out-ok-001",
      "name": "Output Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, -120],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "item_id", "type": "string", "value": "={{ $json.data.create_item.id }}" },
            { "id": "a2", "name": "success", "type": "boolean", "value": "={{ true }}" }
          ]
        },
        "options": { "include": "none" }
      }
    },
    {
      "id": "out-fail-001",
      "name": "Output Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 120],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "b1", "name": "item_id", "type": "string", "value": "" },
            { "id": "b2", "name": "success", "type": "boolean", "value": "={{ false }}" },
            { "id": "b3", "name": "error", "type": "string", "value": "={{ JSON.stringify($json.errors || $json) }}" }
          ]
        },
        "options": { "include": "none" }
      }
    }
  ],
  "connections": {
    "When Called by Another Workflow": {
      "main": [[{ "node": "Build GraphQL Body", "type": "main", "index": 0 }]]
    },
    "Build GraphQL Body": {
      "main": [[{ "node": "Monday - Create Item", "type": "main", "index": 0 }]]
    },
    "Monday - Create Item": {
      "main": [[{ "node": "Did It Succeed?", "type": "main", "index": 0 }]]
    },
    "Did It Succeed?": {
      "main": [
        [{ "node": "Output Success", "type": "main", "index": 0 }],
        [{ "node": "Output Failure", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "America/Los_Angeles" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [{ "name": "murray-ai" }, { "name": "phase-1" }]
}
