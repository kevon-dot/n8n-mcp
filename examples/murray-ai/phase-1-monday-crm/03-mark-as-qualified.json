{
  "name": "Murray AI — P1.3 Mark as Qualified",
  "nodes": [
    {
      "id": "sticky-003",
      "name": "Placeholders to Swap",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-720, -380],
      "parameters": {
        "content": "## Phase 1.3 — Mark as Qualified\n\nFinds a Leads Board item by email, moves it to the Qualified Pipe Reply group, writes `status=Qualified`, `reply_received_date`, `reply_snippet`.\n\n**Inputs:** `email`, `reply_received_date` (YYYY-MM-DD), `reply_snippet` (first 200 chars).\n\n### No find-and-replace needed — every id is read from env\n\n```\nMONDAY_LEADS_BOARD_ID=...\nMONDAY_LEADS_GROUP_QUALIFIED_REPLY=...\nMONDAY_LEADS_COL_EMAIL=...\nMONDAY_LEADS_COL_STATUS=...\nMONDAY_LEADS_COL_REPLY_DATE=...\nMONDAY_LEADS_COL_REPLY_SNIPPET=...\n```\n\n### Behavior\n- If the lead is NOT found on Leads Board, output `{ success: false, error: 'not_found' }`.\n- If found, runs 2 calls: find → batched move+update.\n\n### Credentials\n- Attach a `Monday.com API` credential to both HTTP Request nodes.\n\n### Output\n`{ item_id, success, error? }`",
        "height": 580,
        "width": 420
      }
    },
    {
      "id": "trigger-003",
      "name": "When Called by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-720, 0],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "email", "type": "string" },
            { "name": "reply_received_date", "type": "string" },
            { "name": "reply_snippet", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "build-find-003",
      "name": "Build Find Query",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-480, 0],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({\n  query: 'query ($boardId: ID!, $columnId: String!, $email: String!) { items_page_by_column_values(board_id: $boardId, columns: [{ column_id: $columnId, column_values: [$email] }], limit: 1) { items { id name } } }',\n  variables: {\n    boardId: $env.MONDAY_LEADS_BOARD_ID,\n    columnId: $env.MONDAY_LEADS_COL_EMAIL,\n    email: $json.email\n  },\n  _input: { email: $json.email, reply_received_date: $json.reply_received_date, reply_snippet: $json.reply_snippet }\n}) }}",
        "options": {}
      }
    },
    {
      "id": "http-find-003",
      "name": "Monday - Find Item by Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "mondayComApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "API-Version", "value": "2024-10" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: $json.query, variables: $json.variables }) }}",
        "options": {}
      }
    },
    {
      "id": "merge-input-003",
      "name": "Preserve Inputs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [0, 0],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({\n  item_id: (($json.data && $json.data.items_page_by_column_values && $json.data.items_page_by_column_values.items && $json.data.items_page_by_column_values.items[0]) ? $json.data.items_page_by_column_values.items[0].id : null),\n  email: $('Build Find Query').item.json._input.email,\n  reply_received_date: $('Build Find Query').item.json._input.reply_received_date,\n  reply_snippet: $('Build Find Query').item.json._input.reply_snippet\n}) }}",
        "options": {}
      }
    },
    {
      "id": "guard-found-003",
      "name": "Found on Leads Board?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.item_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "build-move-003",
      "name": "Build Move + Update Body",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, -160],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({\n  query: 'mutation ($boardId: ID!, $itemId: ID!, $groupId: String!, $columnValues: JSON!) { move_item_to_group(item_id: $itemId, group_id: $groupId) { id } change_multiple_column_values(board_id: $boardId, item_id: $itemId, column_values: $columnValues, create_labels_if_missing: true) { id } }',\n  variables: {\n    boardId: $env.MONDAY_LEADS_BOARD_ID,\n    itemId: $json.item_id,\n    groupId: $env.MONDAY_LEADS_GROUP_QUALIFIED_REPLY,\n    columnValues: JSON.stringify({\n      [$env.MONDAY_LEADS_COL_STATUS]: { label: 'Qualified' },\n      [$env.MONDAY_LEADS_COL_REPLY_DATE]: { date: $json.reply_received_date || $now.toFormat('yyyy-MM-dd') },\n      [$env.MONDAY_LEADS_COL_REPLY_SNIPPET]: (($json.reply_snippet || '').substring(0, 200))\n    })\n  },\n  item_id: $json.item_id\n}) }}",
        "options": {}
      }
    },
    {
      "id": "http-move-003",
      "name": "Monday - Move + Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -160],
      "parameters": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "mondayComApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "API-Version", "value": "2024-10" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: $json.query, variables: $json.variables }) }}",
        "options": {}
      }
    },
    {
      "id": "out-ok-003",
      "name": "Output Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, -160],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "item_id", "type": "string", "value": "={{ $('Build Move + Update Body').item.json.item_id }}" },
            { "id": "a2", "name": "success", "type": "boolean", "value": "={{ !($json.errors) }}" },
            { "id": "a3", "name": "error", "type": "string", "value": "={{ $json.errors ? JSON.stringify($json.errors) : '' }}" }
          ]
        },
        "options": { "include": "none" }
      }
    },
    {
      "id": "out-notfound-003",
      "name": "Output Not Found",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 160],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "b1", "name": "item_id", "type": "string", "value": "" },
            { "id": "b2", "name": "success", "type": "boolean", "value": "={{ false }}" },
            { "id": "b3", "name": "error", "type": "string", "value": "not_found" }
          ]
        },
        "options": { "include": "none" }
      }
    }
  ],
  "connections": {
    "When Called by Another Workflow": {
      "main": [[{ "node": "Build Find Query", "type": "main", "index": 0 }]]
    },
    "Build Find Query": {
      "main": [[{ "node": "Monday - Find Item by Email", "type": "main", "index": 0 }]]
    },
    "Monday - Find Item by Email": {
      "main": [[{ "node": "Preserve Inputs", "type": "main", "index": 0 }]]
    },
    "Preserve Inputs": {
      "main": [[{ "node": "Found on Leads Board?", "type": "main", "index": 0 }]]
    },
    "Found on Leads Board?": {
      "main": [
        [{ "node": "Build Move + Update Body", "type": "main", "index": 0 }],
        [{ "node": "Output Not Found", "type": "main", "index": 0 }]
      ]
    },
    "Build Move + Update Body": {
      "main": [[{ "node": "Monday - Move + Update", "type": "main", "index": 0 }]]
    },
    "Monday - Move + Update": {
      "main": [[{ "node": "Output Success", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "America/Los_Angeles" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [{ "name": "murray-ai" }, { "name": "phase-1" }]
}
